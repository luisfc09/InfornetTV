# Server
NODE_ENV=development
PORT=3001

# Supabase — projeto InfornetTV (etxqvoyzyzuzdbchoucd)
SUPABASE_URL=https://etxqvoyzyzuzdbchoucd.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Database (Postgres do Supabase). Pegue a senha no painel do projeto.
# - Conexão direta (IPv6): db.<ref>.supabase.co:5432 — ok em redes com IPv6.
# - Pooler Supavisor (IPv4): use em plataformas sem IPv6 (Railway, etc.):
#   postgres.<ref>:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
#   (o prefixo da região — aws-0/aws-1 — varia por projeto; este é aws-1)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.etxqvoyzyzuzdbchoucd.supabase.co:5432/postgres

# JWT
JWT_SECRET=your_super_secret_key_here_change_in_prod
JWT_EXPIRY=7d

# CDN TV API
CDN_TV_API_KEY=your_cdn_tv_api_key
CDN_TV_BASE_URL=https://api.cdntv.com.br

# Paramount
PARAMOUNT_API_KEY=pending

# HBO
HBO_API_KEY=pending
