# Server
NODE_ENV=development
PORT=3001

# Supabase — projeto InfornetTV (etxqvoyzyzuzdbchoucd)
# Chaves: painel do projeto > Settings > API (ou `supabase projects api-keys`)
SUPABASE_URL=https://etxqvoyzyzuzdbchoucd.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# compat: nome antigo usado por código legado
SUPABASE_KEY=your_anon_key

# Database (Postgres do Supabase). Pegue a senha no painel do projeto.
# - Conexão direta (IPv6): db.<ref>.supabase.co:5432 — ok em redes com IPv6.
# - Pooler Supavisor (IPv4): use em plataformas sem IPv6 (Railway, etc.):
#   postgres.<ref>:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
#   (o prefixo da região — aws-0/aws-1 — varia por projeto; este é aws-1)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.etxqvoyzyzuzdbchoucd.supabase.co:5432/postgres

# Providers de streaming (bootstrap; a fonte administrável é a tabela
# streaming_providers, gerida pelo Admin Panel)
CDN_TV_API_KEY=pending
CDN_TV_BASE_URL=https://api.cdntv.com.br
WATCHTV_API_KEY=pending
WATCHTV_BASE_URL=https://api.watchtv.com.br
PARAMOUNT_API_KEY=pending
PARAMOUNT_BASE_URL=https://api.paramount.com

# JWT (app de usuários)
JWT_SECRET=your_super_secret_key_here_change_in_prod
JWT_EXPIRY=7d

# JWT do Admin Panel — secret DIFERENTE do de usuários: um token de user
# nunca pode validar nas rotas /api/admin/**
ADMIN_JWT_SECRET=another_secret_key_admin_different
ADMIN_JWT_EXPIRY=30d

# Asaas (billing)
ASAAS_API_KEY=pending
ASAAS_BASE_URL=https://api.asaas.com/v3
# Token de verificação do webhook (configure o mesmo valor no painel do Asaas
# em Webhooks → Auth Token). Sem ele o endpoint /api/webhooks/asaas recusa.
ASAAS_WEBHOOK_TOKEN=

# Anthropic (Duda — mensagens de reengajamento via Claude)
# Sem a chave, o restante da Duda funciona; só a geração de mensagens desativa.
ANTHROPIC_API_KEY=

# Criptografia dos segredos de provider (usuário/senha do painel Xtream).
# Qualquer string forte; sem ela, as credenciais ficam em texto puro (com aviso).
ENCRYPTION_KEY=
